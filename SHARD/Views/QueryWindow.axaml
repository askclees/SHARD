<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SHARD.ViewModels"
        xmlns:dg="using:Avalonia.Controls"
        x:Class="SHARD.Views.QueryWindow"
        Title="Query"
        Width="900"
        Height="600"
        MinWidth="500"
        MinHeight="300"
        WindowStartupLocation="CenterOwner">

    <Grid ColumnDefinitions="220,4,*">

        <!-- Left: table list -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Padding="10,6"
                    BorderThickness="0,0,0,1">
                <TextBlock Text="Tables"
                           FontWeight="SemiBold"
                           FontSize="11"
                           Opacity="0.6" />
            </Border>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding TableNames}"
                     DoubleTapped="OnTableDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:QueryTableViewModel">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontFamily="Courier New"
                                   FontSize="12"
                                   ToolTip.Tip="Double-click to query this table" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

        <!-- Right: query editor + results -->
        <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*">

            <!-- Query bar -->
            <Border Grid.Row="0"
                    Padding="10,6"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding QueryText}"
                             Watermark="SELECT * FROM table_name  (Enter to run, Shift+Enter for new line)"
                             FontFamily="Courier New"
                             FontSize="12"
                             AcceptsReturn="False"
                             MinHeight="32"
                             MaxHeight="120"
                             TextWrapping="Wrap"
                             KeyDown="OnQueryBoxKeyDown" />
                    <Button Grid.Column="1"
                            Content="Run"
                            Command="{Binding RunQueryCommand}"
                            Padding="16,4"
                            Margin="6,0,0,0"
                            VerticalAlignment="Top" />
                </Grid>
            </Border>

            <!-- Record scope: live / recovered / both -->
            <Border Grid.Row="1"
                    Padding="10,4"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="14">
                    <RadioButton GroupName="RecordScope"
                                 Content="Live only"
                                 IsChecked="{Binding IsLiveOnly}"
                                 FontSize="11" />
                    <RadioButton GroupName="RecordScope"
                                 Content="Recovered only"
                                 IsChecked="{Binding IsRecoveredOnly}"
                                 FontSize="11"
                                 ToolTip.Tip="Query the _shard_recovered_* table instead of the live table — includes _page_number/_cell_offset/_recovery_method so double-clicking a row jumps to where it was recovered from." />
                    <RadioButton GroupName="RecordScope"
                                 Content="Live + Recovered"
                                 IsChecked="{Binding IsLiveAndRecovered}"
                                 FontSize="11"
                                 ToolTip.Tip="Union both, tagged with an _is_recovered column." />
                </StackPanel>
            </Border>

            <!-- Error / summary row -->
            <TextBlock Grid.Row="2"
                       Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       Foreground="#E05C5C"
                       Padding="10,4"
                       FontSize="11" />
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto"
                  IsVisible="{Binding HasRun}">
                <TextBlock Grid.Column="0"
                           Text="{Binding Summary}"
                           Opacity="0.55"
                           Padding="10,4"
                           VerticalAlignment="Center"
                           FontSize="11" />
                <Button Grid.Column="1"
                        Content="Export CSV"
                        IsVisible="{Binding HasResults}"
                        Click="OnExportCsvClick"
                        Padding="10,3"
                        Margin="0,2,10,2"
                        FontSize="11" />
            </Grid>

            <!-- Results grid -->
            <dg:DataGrid Grid.Row="4"
                         x:Name="ResultsGrid"
                         ItemsSource="{Binding Results}"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         GridLinesVisibility="All"
                         Margin="10"
                         FontSize="12"
                         DoubleTapped="OnQueryResultDoubleTapped" />

        </Grid>

    </Grid>

</Window>
