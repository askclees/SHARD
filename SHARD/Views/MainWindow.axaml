<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SHARD.ViewModels"
        xmlns:controls="using:SHARD.Controls"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:core="using:SHARD.Core"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="SHARD.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SHARD — SQLite Forensic Analyser"
        Width="1200" Height="760"
        MinWidth="800" MinHeight="500"
        DragDrop.AllowDrop="True">

    <DockPanel>

        <!-- ═══ Menu bar ═══════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Database…"
                          Name="MenuOpen"
                          InputGesture="Ctrl+O" />
                <MenuItem Header="_Close"
                          Name="MenuClose"
                          IsEnabled="{Binding HasDatabase}"
                          InputGesture="Ctrl+W" />
                <Separator />
                <MenuItem Header="Create _Project…"
                          Name="MenuCreateProject"
                          IsEnabled="{Binding HasDatabase}" />
                <MenuItem Header="_Open Project…"
                          Name="MenuOpenProject" />
                <Separator />
                <MenuItem Header="E_xit"
                          Name="MenuExit" />
            </MenuItem>
        </Menu>

        <!-- ═══ Status bar ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Padding="10,4"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Opacity="0.75" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ProjectFolderPath, StringFormat='Project: {0}'}"
                           IsVisible="{Binding HasProject}"
                           FontSize="12"
                           Opacity="0.6"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- ═══ Content area (switches between empty-state and main view) ═══ -->
        <Grid>

            <!-- ─── Empty state ─────────────────────────────────────────── -->
            <StackPanel IsVisible="{Binding HasNoDatabase}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">

                <TextBlock Text="SHARD"
                           FontSize="52"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Opacity="0.9" />

                <TextBlock Text="SQLite Forensic Analyser"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Opacity="0.45" />

                <Border Height="1" Margin="0,8" Opacity="0.15" />

                <Button Name="BtnOpen"
                        Content="Open SQLite Database…"
                        HorizontalAlignment="Center"
                        Padding="28,10"
                        FontSize="14" />

                <TextBlock Text="or drag a .db / .sqlite file here"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Opacity="0.35" />
            </StackPanel>

            <!-- ─── Main view ────────────────────────────────────────────── -->
            <Grid IsVisible="{Binding HasDatabase}">

                <TabControl Padding="0">

                    <!-- ── Tab 1: Database Header ── -->
                    <TabItem Header="Database Header">
                        <Grid ColumnDefinitions="*,4,*">

                            <!-- Left: field details -->
                            <ScrollViewer Grid.Column="0"
                                          Padding="16,12"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding DatabaseInfoRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InfoRow">
                                            <Grid ColumnDefinitions="220,*" Margin="0,4">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.6"
                                                           FontSize="12" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                            <!-- Right: hex dump of first 100 bytes -->
                            <Grid Grid.Column="2" RowDefinitions="Auto,*">

                                <!-- Toolbar -->
                                <Border Grid.Row="0"
                                        Padding="8,4"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ToggleButton x:Name="HdrOffsetToggle"
                                                      Content="Dec Offsets"
                                                      ToolTip.Tip="Toggle between hexadecimal (default) and decimal offsets"
                                                      IsChecked="False"
                                                      Padding="8,2"
                                                      FontSize="11" />
                                        <ToggleButton x:Name="HdrHighlightToggle"
                                                      Content="Highlights"
                                                      ToolTip.Tip="Toggle field highlights on/off"
                                                      IsChecked="True"
                                                      Padding="8,2"
                                                      FontSize="11" />
                                        <TextBlock x:Name="HdrFieldLabel"
                                                   Text="{Binding #HdrHexView.HoveredLabel}"
                                                   IsVisible="{Binding #HdrHexView.HoveredLabel,
                                                               Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Opacity="0.75"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Hex view -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <controls:HexView x:Name="HdrHexView"
                                                      Margin="14,8,14,16"
                                                      Data="{Binding HeaderBytes}"
                                                      Highlights="{Binding HeaderHighlights}"
                                                      UseDecimalOffsets="{Binding #HdrOffsetToggle.IsChecked}"
                                                      ShowHighlights="{Binding #HdrHighlightToggle.IsChecked}" />
                                </ScrollViewer>

                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- ── Tab 2: Pages ── -->
                    <TabItem Header="Pages">
                        <Grid ColumnDefinitions="250,4,*">

                            <!-- Left: page list -->
                            <ListBox Grid.Column="0"
                                     ItemsSource="{Binding Pages}"
                                     SelectedItem="{Binding SelectedPage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PageViewModel">
                                        <Grid ColumnDefinitions="5,44,*" Height="26">

                                            <!-- Type colour swatch -->
                                            <Border Grid.Column="0"
                                                    Background="{Binding TypeBrush}"
                                                    CornerRadius="2,0,0,2" />

                                            <!-- Page number -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PageNumber}"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       Padding="0,0,8,0"
                                                       FontSize="11"
                                                       Opacity="0.5" />

                                            <!-- Page type -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TypeLabel}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                            <!-- Right: page detail -->
                            <Grid Grid.Column="2">

                                <!-- No page selected placeholder -->
                                <TextBlock IsVisible="{Binding SelectedPage,
                                                       Converter={x:Static conv:ObjectConverters.IsNull}}"
                                           Text="← Select a page from the list"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.35"
                                           FontSize="13" />

                                <!-- Page content -->
                                <Grid IsVisible="{Binding SelectedPage,
                                                  Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                      ColumnDefinitions="*,4,*">

                                    <!-- Left: summary + expandable sections -->
                                    <ScrollViewer Grid.Column="0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Margin="14,10" Spacing="6">

                                            <!-- Basic page info -->
                                            <TextBlock Text="{Binding SelectedPage.Summary}"
                                                       FontFamily="Courier New"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />

                                            <!-- Cell pointers -->
                                            <Expander Header="{Binding SelectedPage.CellPointerHeader}"
                                                      IsExpanded="False"
                                                      IsVisible="{Binding SelectedPage.HasCellPointers}">
                                                <ItemsControl ItemsSource="{Binding SelectedPage.CellPointerRows}"
                                                              Margin="8,4,0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:InfoRow">
                                                            <Grid ColumnDefinitions="52,*" Margin="0,2">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Label}"
                                                                           FontFamily="Courier New"
                                                                           FontSize="11"
                                                                           Opacity="0.55" />
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Value}"
                                                                           FontFamily="Courier New"
                                                                           FontSize="11" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>

                                            <!-- Per-cell expanders (table leaf pages only) -->
                                            <ItemsControl ItemsSource="{Binding SelectedPage.CellSections}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CellSectionViewModel">
                                                        <Expander Header="{Binding Header}"
                                                                  IsExpanded="False"
                                                                  Expanded="OnCellSectionExpanded"
                                                                  Margin="0,2,0,0">
                                                            <ItemsControl ItemsSource="{Binding Rows}"
                                                                          Margin="8,4,0,4">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:InfoRow">
                                                                        <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                            <TextBlock Grid.Column="0"
                                                                                       Text="{Binding Label}"
                                                                                       FontSize="12"
                                                                                       FontWeight="SemiBold"
                                                                                       Opacity="0.6" />
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Value}"
                                                                                       FontSize="12"
                                                                                       TextWrapping="Wrap" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </ScrollViewer>

                                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                                    <!-- Right: toolbar + hex view -->
                                    <Grid Grid.Column="2" RowDefinitions="Auto,*">

                                        <Border Grid.Row="0"
                                                Padding="8,4"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ToggleButton x:Name="PageOffsetToggle"
                                                              Content="Dec Offsets"
                                                              ToolTip.Tip="Toggle between hexadecimal (default) and decimal offsets"
                                                              IsChecked="False"
                                                              Padding="8,2"
                                                              FontSize="11" />
                                                <ToggleButton x:Name="PageHighlightToggle"
                                                              Content="Highlights"
                                                              ToolTip.Tip="Toggle field highlights on/off"
                                                              IsChecked="True"
                                                              Padding="8,2"
                                                              FontSize="11" />
                                                <TextBlock Text="{Binding #PageHexView.HoveredLabel}"
                                                           IsVisible="{Binding #PageHexView.HoveredLabel,
                                                                       Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Opacity="0.75"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                            <ScrollViewer Grid.Column="0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto">
                                                <controls:HexView x:Name="PageHexView"
                                                                  Margin="14,8,14,16"
                                                                  Data="{Binding SelectedPage.PageBytes}"
                                                                  Highlights="{Binding SelectedPage.PageHighlights}"
                                                                  UseDecimalOffsets="{Binding #PageOffsetToggle.IsChecked}"
                                                                  ShowHighlights="{Binding #PageHighlightToggle.IsChecked}" />
                                            </ScrollViewer>
                                            <controls:DataInspectorControl Grid.Column="1"
                                                                           Data="{Binding #PageHexView.Data}"
                                                                           Offset="{Binding #PageHexView.CursorOffset}" />
                                        </Grid>

                                    </Grid>

                                </Grid>
                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- ── Tab 3: Schema ── -->
                    <TabItem Header="Schema">
                        <Grid ColumnDefinitions="*,4,*">

                            <!-- Left: column headers + selectable row list -->
                            <Grid Grid.Column="0" RowDefinitions="Auto,*">

                                <Border Grid.Row="0"
                                        Padding="10,6"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="80,180,180,80,*">
                                        <TextBlock Grid.Column="0" Text="Type"      FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                        <TextBlock Grid.Column="1" Text="Name"      FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                        <TextBlock Grid.Column="2" Text="Table"     FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                        <TextBlock Grid.Column="3" Text="Root Page" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                        <TextBlock Grid.Column="4" Text="SQL"       FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding SchemaRows}"
                                         SelectedItem="{Binding SelectedSchemaRow}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:SqliteMasterRow">
                                            <Grid ColumnDefinitions="80,180,180,80,*" Margin="4,3">
                                                <TextBlock Grid.Column="0" Text="{Binding ObjectType}" FontSize="12" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"       FontSize="12" />
                                                <TextBlock Grid.Column="2" Text="{Binding TableName}"  FontSize="12" />
                                                <TextBlock Grid.Column="3" Text="{Binding RootPage}"   FontSize="12" />
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding Sql}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Sql}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                            </Grid>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                            <!-- Right: hex view of the selected row's page -->
                            <Grid Grid.Column="2">

                                <TextBlock IsVisible="{Binding SelectedSchemaRow,
                                                       Converter={x:Static conv:ObjectConverters.IsNull}}"
                                           Text="← Select a row to view its bytes"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.35"
                                           FontSize="13" />

                                <Grid IsVisible="{Binding SelectedSchemaRow,
                                                  Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                      RowDefinitions="Auto,*">

                                    <Border Grid.Row="0"
                                            Padding="8,4"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ToggleButton x:Name="SchemaOffsetToggle"
                                                          Content="Dec Offsets"
                                                          IsChecked="False"
                                                          Padding="8,2"
                                                          FontSize="11" />
                                            <ToggleButton x:Name="SchemaHighlightToggle"
                                                          Content="Highlights"
                                                          IsChecked="True"
                                                          Padding="8,2"
                                                          FontSize="11" />
                                            <TextBlock Text="{Binding SelectedSchemaRow.PageNumber, StringFormat='Page {0}'}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       Margin="8,0,0,0" />
                                            <TextBlock Text="{Binding #SchemaHexView.HoveredLabel}"
                                                       IsVisible="{Binding #SchemaHexView.HoveredLabel,
                                                                   Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Auto">
                                        <controls:HexView x:Name="SchemaHexView"
                                                          Margin="14,8,14,16"
                                                          Data="{Binding SchemaPageBytes}"
                                                          Highlights="{Binding SchemaHighlights}"
                                                          UseDecimalOffsets="{Binding #SchemaOffsetToggle.IsChecked}"
                                                          ShowHighlights="{Binding #SchemaHighlightToggle.IsChecked}" />
                                    </ScrollViewer>

                                </Grid>
                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- ── Tab 4: Search ── -->
                    <TabItem Header="Search">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">

                            <!-- Search bar -->
                            <Border Grid.Row="0"
                                    Padding="10,6"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SearchTab.Pattern}"
                                             Watermark="Regular expression  (e.g.  CREATE TABLE|\x00\xFF)"
                                             FontFamily="Courier New"
                                             FontSize="12"
                                             KeyDown="OnSearchBoxKeyDown" />
                                    <Button Grid.Column="1"
                                            Content="Search"
                                            Command="{Binding SearchTab.SearchCommand}"
                                            Padding="16,4"
                                            Margin="6,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- Error / summary row -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding SearchTab.ErrorMessage}"
                                       IsVisible="{Binding SearchTab.ErrorMessage,
                                                   Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                       Foreground="#E05C5C"
                                       Padding="10,4"
                                       FontSize="11" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding SearchTab.Summary}"
                                       IsVisible="{Binding SearchTab.HasResults}"
                                       Opacity="0.55"
                                       Padding="10,2"
                                       FontSize="11" />

                            <!-- Placeholder: not searched yet -->
                            <TextBlock Grid.Row="3"
                                       IsVisible="{Binding SearchTab.ShowPlaceholder}"
                                       Text="Enter a pattern above and click Search"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.35"
                                       FontSize="13" />

                            <!-- Placeholder: no results -->
                            <TextBlock Grid.Row="3"
                                       IsVisible="{Binding SearchTab.ShowNoResults}"
                                       Text="No matches found"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.35"
                                       FontSize="13" />

                            <!-- Results: grouped list + hex view -->
                            <Grid Grid.Row="3"
                                  IsVisible="{Binding SearchTab.HasResults}"
                                  ColumnDefinitions="260,4,*">

                                <!-- Left: page groups -->
                                <ScrollViewer Grid.Column="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SearchTab.Results}"
                                                  Margin="4,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SearchPageGroupViewModel">
                                                <Expander Header="{Binding Header}"
                                                          IsExpanded="False"
                                                          Expanded="OnSearchGroupExpanded"
                                                          Margin="0,2,0,0">
                                                    <ItemsControl ItemsSource="{Binding Hits}"
                                                                  Margin="8,2,0,2">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SearchHitViewModel">
                                                                <Button Content="{Binding Preview}"
                                                                        Click="OnSearchHitClicked"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left"
                                                                        Padding="6,3"
                                                                        Margin="0,1"
                                                                        FontFamily="Courier New"
                                                                        FontSize="11" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                                <!-- Right: toolbar + hex view -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,*">

                                    <Border Grid.Row="0"
                                            Padding="8,4"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ToggleButton x:Name="SearchOffsetToggle"
                                                          Content="Dec Offsets"
                                                          IsChecked="False"
                                                          Padding="8,2"
                                                          FontSize="11" />
                                            <ToggleButton x:Name="SearchHighlightToggle"
                                                          Content="Highlights"
                                                          IsChecked="True"
                                                          Padding="8,2"
                                                          FontSize="11" />
                                            <TextBlock Text="{Binding #SearchHexView.HoveredLabel}"
                                                       IsVisible="{Binding #SearchHexView.HoveredLabel,
                                                                   Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                        <ScrollViewer Grid.Column="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto">
                                            <controls:HexView x:Name="SearchHexView"
                                                              Margin="14,8,14,16"
                                                              Data="{Binding SearchTab.SelectedPageBytes}"
                                                              Highlights="{Binding SearchTab.SelectedHighlights}"
                                                              UseDecimalOffsets="{Binding #SearchOffsetToggle.IsChecked}"
                                                              ShowHighlights="{Binding #SearchHighlightToggle.IsChecked}" />
                                        </ScrollViewer>
                                        <controls:DataInspectorControl Grid.Column="1"
                                                                       Data="{Binding #SearchHexView.Data}"
                                                                       Offset="{Binding #SearchHexView.CursorOffset}" />
                                    </Grid>

                                </Grid>
                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- ── Tab 5: Query ── -->
                    <TabItem Header="Query">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">

                            <!-- Placeholder: no project yet -->
                            <TextBlock Grid.Row="0" Grid.RowSpan="4"
                                       IsVisible="{Binding HasProject, Converter={x:Static conv:BoolConverters.Not}}"
                                       Text="Create a project to run SQL queries against its shadow database."
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.35"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       MaxWidth="360"
                                       TextAlignment="Center" />

                            <Grid Grid.Row="0" Grid.RowSpan="4"
                                  IsVisible="{Binding HasProject}"
                                  ColumnDefinitions="220,4,*">

                                <!-- Left: table list -->
                                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                                    <Border Grid.Row="0"
                                            Padding="10,6"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="Tables"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Opacity="0.6" />
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding QueryTab.TableNames}"
                                             DoubleTapped="OnTableDoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{Binding}"
                                                           FontFamily="Courier New"
                                                           FontSize="12"
                                                           ToolTip.Tip="Double-click to query this table" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                                <!-- Right: query editor + results -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,*">

                                    <!-- Query bar -->
                                    <Border Grid.Row="0"
                                            Padding="10,6"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding QueryTab.QueryText}"
                                                     Watermark="SELECT * FROM table_name"
                                                     FontFamily="Courier New"
                                                     FontSize="12"
                                                     AcceptsReturn="True"
                                                     MinHeight="32"
                                                     MaxHeight="120"
                                                     TextWrapping="Wrap"
                                                     KeyDown="OnQueryBoxKeyDown" />
                                            <Button Grid.Column="1"
                                                    Content="Run"
                                                    Command="{Binding QueryTab.RunQueryCommand}"
                                                    Padding="16,4"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>

                                    <!-- Error / summary row -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding QueryTab.ErrorMessage}"
                                               IsVisible="{Binding QueryTab.HasError}"
                                               Foreground="#E05C5C"
                                               Padding="10,4"
                                               FontSize="11" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding QueryTab.Summary}"
                                               IsVisible="{Binding QueryTab.HasRun}"
                                               Opacity="0.55"
                                               Padding="10,2"
                                               FontSize="11" />

                                    <!-- Results grid -->
                                    <dg:DataGrid Grid.Row="3"
                                                 x:Name="ResultsGrid"
                                                 ItemsSource="{Binding QueryTab.Results}"
                                                 AutoGenerateColumns="False"
                                                 IsReadOnly="True"
                                                 GridLinesVisibility="All"
                                                 Margin="10"
                                                 FontSize="12" />

                                </Grid>

                            </Grid>

                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
