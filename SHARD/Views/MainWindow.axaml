<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SHARD.ViewModels"
        xmlns:controls="using:SHARD.Controls"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:core="using:SHARD.Core"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        x:Class="SHARD.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="SHARD — SQLite Forensic Analyser"
        Icon="avares://SHARD/Assets/shard-icon.png"
        Width="1200" Height="760"
        MinWidth="800" MinHeight="500"
        DragDrop.AllowDrop="True">

    <DockPanel>

        <!-- ═══ Menu bar ═══════════════════════════════════════════════════ -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Database…"
                          Name="MenuOpen"
                          InputGesture="Ctrl+O" />
                <MenuItem Header="_Close"
                          Name="MenuClose"
                          IsEnabled="{Binding HasDatabase}"
                          InputGesture="Ctrl+W" />
                <Separator />
                <MenuItem Header="_Save Project…"
                          Name="MenuSaveProject"
                          IsEnabled="{Binding HasDatabase}" />
                <MenuItem Header="_Open Project…"
                          Name="MenuOpenProject" />
                <Separator />
                <MenuItem Header="Load _WAL File…"
                          Name="MenuLoadWal"
                          IsEnabled="{Binding HasDatabase}" />
                <Separator />
                <MenuItem Header="E_xit"
                          Name="MenuExit" />
            </MenuItem>
        </Menu>

        <!-- ═══ Status bar ══════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Padding="10,4"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           Opacity="0.75" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ProjectFolderPath, StringFormat='Project: {0}'}"
                           IsVisible="{Binding HasProject}"
                           FontSize="12"
                           Opacity="0.6"
                           Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- ═══ Content area (switches between empty-state and main view) ═══ -->
        <Grid>

            <!-- ─── Empty state ─────────────────────────────────────────── -->
            <StackPanel IsVisible="{Binding HasNoDatabase}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">

                <TextBlock Text="SHARD"
                           FontSize="52"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Opacity="0.9" />

                <TextBlock Text="SQLite Forensic Analyser"
                           FontSize="15"
                           HorizontalAlignment="Center"
                           Opacity="0.45" />

                <Border Height="1" Margin="0,8" Opacity="0.15" />

                <Button Name="BtnOpen"
                        Content="Open SQLite Database…"
                        HorizontalAlignment="Center"
                        Padding="28,10"
                        FontSize="14" />

                <TextBlock Text="or drag a .db / .sqlite file here"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Opacity="0.35" />
            </StackPanel>

            <!-- ─── Main view ────────────────────────────────────────────── -->
            <Grid IsVisible="{Binding HasDatabase}">

                <TabControl Padding="0">

                    <!-- ── Tab 1: Database Header ── -->
                    <TabItem Header="Database Header">
                        <Grid ColumnDefinitions="*,4,*">

                            <!-- Left: field details -->
                            <ScrollViewer Grid.Column="0"
                                          Padding="16,12"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding DatabaseInfoRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InfoRow">
                                            <Grid ColumnDefinitions="220,*" Margin="0,4">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Label}"
                                                           FontWeight="SemiBold"
                                                           Opacity="0.6"
                                                           FontSize="12" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Value}"
                                                           TextWrapping="Wrap"
                                                           FontSize="12" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                            <!-- Right: hex dump of first 100 bytes -->
                            <Grid Grid.Column="2" RowDefinitions="Auto,*">

                                <!-- Toolbar -->
                                <Border Grid.Row="0"
                                        Padding="8,4"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ToggleButton x:Name="HdrOffsetToggle"
                                                      Content="Dec Offsets"
                                                      ToolTip.Tip="Toggle between hexadecimal (default) and decimal offsets"
                                                      IsChecked="False"
                                                      Padding="8,2"
                                                      FontSize="11" />
                                        <ToggleButton x:Name="HdrHighlightToggle"
                                                      Content="Highlights"
                                                      ToolTip.Tip="Toggle field highlights on/off"
                                                      IsChecked="True"
                                                      Padding="8,2"
                                                      FontSize="11" />
                                        <TextBlock x:Name="HdrFieldLabel"
                                                   Text="{Binding #HdrHexView.HoveredLabel}"
                                                   IsVisible="{Binding #HdrHexView.HoveredLabel,
                                                               Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Opacity="0.75"
                                                   Margin="8,0,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- Hex view -->
                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <controls:HexView x:Name="HdrHexView"
                                                      Margin="14,8,14,16"
                                                      Data="{Binding HeaderBytes}"
                                                      Highlights="{Binding HeaderHighlights}"
                                                      UseDecimalOffsets="{Binding #HdrOffsetToggle.IsChecked}"
                                                      ShowHighlights="{Binding #HdrHighlightToggle.IsChecked}" />
                                </ScrollViewer>

                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- ── Tab 2: Pages ── -->
                    <TabItem Header="Pages">
                        <Grid RowDefinitions="Auto,*">

                            <!-- Filter panel: two rows -->
                            <Border Grid.Row="0"
                                    Padding="6,4"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Spacing="4">

                                    <!-- Row 1: Page type toggles -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Type:"
                                                   FontSize="11"
                                                   Opacity="0.6"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,4,0"/>
                                        <ItemsControl ItemsSource="{Binding PageTypeFilters}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PageTypeToggleViewModel">
                                                    <ToggleButton IsChecked="{Binding IsSelected}"
                                                                  Padding="5,2"
                                                                  FontSize="11">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <Border Width="8" Height="8"
                                                                    CornerRadius="2"
                                                                    Background="{Binding Brush}"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </StackPanel>
                                                    </ToggleButton>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Row 2: Remaining filters -->
                                    <WrapPanel Orientation="Horizontal">

                                        <!-- Table filter -->
                                        <StackPanel Orientation="Horizontal" Spacing="4"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    IsVisible="{Binding HasAvailableTableNames}">
                                            <TextBlock Text="Table:"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                            <ComboBox ItemsSource="{Binding AvailableTableNames}"
                                                      SelectedItem="{Binding FilterTableName}"
                                                      FontSize="11"
                                                      Width="196"
                                                      MaxWidth="196"
                                                      Padding="4,2">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <TextBlock Text="{Binding}"
                                                                   Width="176"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding}" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Unallocated filters -->
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding FilterHasUnallocated}"
                                                      Content="Has unallocated"
                                                      FontSize="11"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <CheckBox IsChecked="{Binding FilterMinSizeEnabled}" FontSize="11"/>
                                                <TextBlock Text="Unalloc ≥" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding FilterMinSize}"
                                                         IsEnabled="{Binding FilterMinSizeEnabled}"
                                                         Width="50" FontSize="11" Padding="4,2"/>
                                                <TextBlock Text="bytes" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <CheckBox IsChecked="{Binding FilterMinNonZeroEnabled}" FontSize="11"/>
                                                <TextBlock Text="Non-zero ≥" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBox Text="{Binding FilterMinNonZero}"
                                                         IsEnabled="{Binding FilterMinNonZeroEnabled}"
                                                         Width="50" FontSize="11" Padding="4,2"/>
                                                <TextBlock Text="bytes" FontSize="11" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Deleted filters -->
                                        <StackPanel Orientation="Horizontal" Spacing="8"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding FilterHasDeletedPointers}"
                                                      Content="Has deleted pointers"
                                                      FontSize="11"/>
                                            <CheckBox IsChecked="{Binding FilterHasDeletedRecords}"
                                                      Content="Has deleted records"
                                                      FontSize="11"/>
                                        </StackPanel>

                                        <!-- Logic toggle + count -->
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <ToggleButton IsChecked="{Binding UseOrLogic}"
                                                          Content="{Binding LogicModeLabel}"
                                                          FontSize="11"
                                                          Padding="6,2"/>
                                            <TextBlock Text="{Binding FilterCountLabel}"
                                                       FontSize="11"
                                                       Opacity="0.6"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                    </WrapPanel>

                                </StackPanel>
                            </Border>

                            <!-- Page list + detail -->
                            <Grid Grid.Row="1" ColumnDefinitions="250,4,*">

                                <ListBox Grid.Column="0"
                                         ItemsSource="{Binding FilteredPages}"
                                         SelectedItem="{Binding SelectedPage}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PageListEntryViewModel">
                                        <Grid ColumnDefinitions="5,44,Auto,*" Height="26">

                                            <!-- Type colour swatch -->
                                            <Border Grid.Column="0"
                                                    Background="{Binding TypeBrush}"
                                                    CornerRadius="2,0,0,2" />

                                            <!-- Page number -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding PageNumber}"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       Padding="0,0,8,0"
                                                       FontSize="11"
                                                       Opacity="0.5" />

                                            <!-- Page type -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TypeLabel}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12" />

                                            <!-- Associated table (when known) -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TableName}"
                                                       IsVisible="{Binding TableName,
                                                                   Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       Padding="8,0,8,0"
                                                       FontSize="11"
                                                       Opacity="0.5" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                            <!-- Right: page detail -->
                            <Grid Grid.Column="2">

                                <!-- No page selected placeholder -->
                                <TextBlock IsVisible="{Binding SelectedPageDetail,
                                                       Converter={x:Static conv:ObjectConverters.IsNull}}"
                                           Text="← Select a page from the list"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.35"
                                           FontSize="13" />

                                <!-- Page content -->
                                <Grid IsVisible="{Binding SelectedPageDetail,
                                                  Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                      ColumnDefinitions="*,4,*">

                                    <!-- Left: tabbed detail sections -->
                                    <TabControl Grid.Column="0" Padding="0">

                                        <!-- Tab 1: Page Information -->
                                        <TabItem Header="Page Information">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel Margin="14,10" Spacing="6">
                                                    <TextBlock Text="{Binding SelectedPageDetail.Summary}"
                                                               FontFamily="Courier New"
                                                               FontSize="12"
                                                               TextWrapping="Wrap" />
                                                    <Expander Header="{Binding SelectedPageDetail.CellPointerHeader}"
                                                              IsExpanded="False"
                                                              IsVisible="{Binding SelectedPageDetail.HasCellPointers}">
                                                        <ItemsControl ItemsSource="{Binding SelectedPageDetail.CellPointerRows}"
                                                                      Margin="8,4,0,4">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:InfoRow">
                                                                    <Grid ColumnDefinitions="52,*" Margin="0,2">
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding Label}"
                                                                                   FontFamily="Courier New"
                                                                                   FontSize="11"
                                                                                   Opacity="0.55" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding Value}"
                                                                                   FontFamily="Courier New"
                                                                                   FontSize="11" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabItem>

                                        <!-- Tab 2: Cells -->
                                        <TabItem Header="{Binding SelectedPageDetail.CellsTabHeader}">
                                            <Grid>
                                                <TextBlock IsVisible="{Binding SelectedPageDetail.CellSections.Count,
                                                                       Converter={x:Static conv:ObjectConverters.IsNull}}"
                                                           Text="No cells on this page"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.35"
                                                           FontSize="12" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding SelectedPageDetail.CellSections}"
                                                                  Margin="14,10">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CellSectionViewModel">
                                                                <Expander Header="{Binding Header}"
                                                                          IsExpanded="False"
                                                                          Expanded="OnCellSectionExpanded"
                                                                          Margin="0,2,0,0">
                                                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                                                  Margin="8,4,0,4">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:InfoRow">
                                                                                <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Label}"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold"
                                                                                               Opacity="0.6" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Value}"
                                                                                               FontSize="12"
                                                                                               TextWrapping="Wrap" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>

                                        <!-- Tab 3: Freeblocks -->
                                        <TabItem Header="{Binding SelectedPageDetail.FreeBlocksTabHeader}">
                                            <Grid>
                                                <TextBlock IsVisible="{Binding SelectedPageDetail.HasFreeBlocks,
                                                                       Converter={x:Static conv:BoolConverters.Not}}"
                                                           Text="No freeblocks on this page"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.35"
                                                           FontSize="12" />
                                                <ScrollViewer IsVisible="{Binding SelectedPageDetail.HasFreeBlocks}"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding SelectedPageDetail.FreeBlockSections}"
                                                                  Margin="14,10">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:FreeBlockSectionViewModel">
                                                                <Expander Header="{Binding Header}"
                                                                          IsExpanded="False"
                                                                          Expanded="OnFreeBlockSectionExpanded"
                                                                          Margin="0,2,0,0">
                                                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                                                  Margin="8,4,0,4">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:InfoRow">
                                                                                <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Label}"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold"
                                                                                               Opacity="0.6" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Value}"
                                                                                               FontSize="12"
                                                                                               TextWrapping="Wrap" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>

                                        <!-- Tab 4: Potential Deleted -->
                                        <TabItem Header="{Binding SelectedPageDetail.DeletedCellsTabHeader}">
                                            <Grid>
                                                <TextBlock IsVisible="{Binding SelectedPageDetail.DeletedCellSections.Count,
                                                                       Converter={x:Static conv:ObjectConverters.IsNull}}"
                                                           Text="No recoverable deleted records found on this page"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.35"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="260"
                                                           TextAlignment="Center" />
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding SelectedPageDetail.DeletedCellSections}"
                                                                  Margin="14,10">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:CellSectionViewModel">
                                                                <Expander Header="{Binding Header}"
                                                                          IsExpanded="False"
                                                                          Expanded="OnCellSectionExpanded"
                                                                          Margin="0,2,0,0">
                                                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                                                  Margin="8,4,0,4">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:InfoRow">
                                                                                <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Label}"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold"
                                                                                               Opacity="0.6" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Value}"
                                                                                               FontSize="12"
                                                                                               TextWrapping="Wrap" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>

                                        <!-- Tab 5: Unallocated Regions -->
                                        <TabItem Header="{Binding FilteredUnallocatedTabHeader}">
                                            <Grid>
                                                <TextBlock IsVisible="{Binding HasFilteredUnallocatedSections,
                                                                       Converter={x:Static conv:BoolConverters.Not}}"
                                                           Text="No unallocated regions (or none pass current filters)"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.35"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="260"
                                                           TextAlignment="Center" />
                                                <ScrollViewer IsVisible="{Binding HasFilteredUnallocatedSections}"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl ItemsSource="{Binding FilteredUnallocatedSections}"
                                                                  Margin="14,10">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:UnallocatedRegionSectionViewModel">
                                                                <Expander Header="{Binding Header}"
                                                                          IsExpanded="False"
                                                                          Expanded="OnUnallocatedRegionSectionExpanded"
                                                                          Margin="0,2,0,0">
                                                                    <ItemsControl ItemsSource="{Binding Rows}"
                                                                                  Margin="8,4,0,4">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:InfoRow">
                                                                                <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding Label}"
                                                                                               FontSize="12"
                                                                                               FontWeight="SemiBold"
                                                                                               Opacity="0.6" />
                                                                                    <TextBlock Grid.Column="1"
                                                                                               Text="{Binding Value}"
                                                                                               FontSize="12"
                                                                                               TextWrapping="Wrap" />
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </Expander>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>

                                    </TabControl>

                                    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                                    <!-- Right: toolbar + hex view -->
                                    <Grid Grid.Column="2" RowDefinitions="Auto,*">

                                        <Border Grid.Row="0"
                                                Padding="8,4"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ToggleButton x:Name="PageOffsetToggle"
                                                              Content="Dec Offsets"
                                                              ToolTip.Tip="Toggle between hexadecimal (default) and decimal offsets"
                                                              IsChecked="False"
                                                              Padding="8,2"
                                                              FontSize="11" />
                                                <ToggleButton x:Name="PageHighlightToggle"
                                                              Content="Highlights"
                                                              ToolTip.Tip="Toggle field highlights on/off"
                                                              IsChecked="True"
                                                              Padding="8,2"
                                                              FontSize="11" />
                                                <TextBlock Text="{Binding #PageHexView.HoveredLabel}"
                                                           IsVisible="{Binding #PageHexView.HoveredLabel,
                                                                       Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Opacity="0.75"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                            <ScrollViewer Grid.Column="0"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto">
                                                <controls:HexView x:Name="PageHexView"
                                                                  Margin="14,8,14,16"
                                                                  Data="{Binding SelectedPageDetail.PageBytes}"
                                                                  Highlights="{Binding SelectedPageDetail.PageHighlights}"
                                                                  UseDecimalOffsets="{Binding #PageOffsetToggle.IsChecked}"
                                                                  ShowHighlights="{Binding #PageHighlightToggle.IsChecked}">
                                                    <controls:HexView.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Try to decode record at this location"
                                                                      Click="OnTryRecoverRecordClicked" />
                                                            <MenuItem Header="Annotate corrupt record at this location…"
                                                                      Click="OnAnnotateCorruptRecordClicked" />
                                                        </ContextMenu>
                                                    </controls:HexView.ContextMenu>
                                                </controls:HexView>
                                            </ScrollViewer>
                                            <controls:DataInspectorControl Grid.Column="1"
                                                                           Data="{Binding #PageHexView.Data}"
                                                                           Offset="{Binding #PageHexView.CursorOffset}" />
                                        </Grid>

                                    </Grid>

                                </Grid>
                            </Grid>

                        </Grid><!-- end page list + detail -->
                    </Grid><!-- end RowDefinitions outer -->
                    </TabItem>

                    <!-- ── Tab 3: Schema ── -->
                    <TabItem Header="Schema">
                        <Grid ColumnDefinitions="*,4,*">

                            <!-- Left: live schema (top) + deleted tables (bottom) -->
                            <Grid Grid.Column="0" RowDefinitions="*,4,*">

                                <!-- Live schema -->
                                <Grid Grid.Row="0" RowDefinitions="Auto,*">
                                    <Border Grid.Row="0"
                                            Padding="10,6"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="80,180,180,80,*">
                                            <TextBlock Grid.Column="0" Text="Type"      FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="1" Text="Name"      FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="2" Text="Table"     FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="3" Text="Root Page" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="4" Text="SQL"       FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                        </Grid>
                                    </Border>

                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding SchemaRows}"
                                             SelectedItem="{Binding SelectedSchemaRow}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:SqliteMasterRow">
                                                <Grid ColumnDefinitions="80,180,180,80,*" Margin="4,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding ObjectType}" FontSize="12" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"       FontSize="12" />
                                                    <TextBlock Grid.Column="2" Text="{Binding TableName}"  FontSize="12" />
                                                    <TextBlock Grid.Column="3" Text="{Binding RootPage}"   FontSize="12" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="{Binding Sql}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding Sql}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                                <!-- Deleted tables -->
                                <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*">

                                    <!-- Section label -->
                                    <Border Grid.Row="0"
                                            Padding="10,5"
                                            BorderThickness="0,1,0,0">
                                        <TextBlock Text="{Binding DeletedSchemaHeader}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Opacity="0.75" />
                                    </Border>

                                    <!-- Column headers -->
                                    <Border Grid.Row="1"
                                            Padding="10,4"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="80,180,80,90,90,*">
                                            <TextBlock Grid.Column="0" Text="Type"      FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="1" Text="Name"      FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="2" Text="Root Page" FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="3" Text="Method"    FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="4" Text="Status"    FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                            <TextBlock Grid.Column="5" Text="SQL"       FontWeight="SemiBold" FontSize="11" Opacity="0.6" />
                                        </Grid>
                                    </Border>

                                    <!-- Placeholder when none found -->
                                    <TextBlock Grid.Row="2"
                                               IsVisible="{Binding HasDeletedSchemaRows,
                                                           Converter={x:Static conv:BoolConverters.Not}}"
                                               Text="No deleted tables found on this database"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Opacity="0.35"
                                               TextWrapping="Wrap"
                                               MaxWidth="220"
                                               TextAlignment="Center" />

                                    <ListBox Grid.Row="2"
                                             IsVisible="{Binding HasDeletedSchemaRows}"
                                             ItemsSource="{Binding DeletedSchemaRows}"
                                             SelectedItem="{Binding SelectedDeletedSchemaRow}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:DeletedSchemaRowViewModel">
                                                <Grid ColumnDefinitions="80,180,80,90,90,*" Margin="4,3">
                                                    <TextBlock Grid.Column="0" Text="{Binding ObjectType}" FontSize="12" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}"       FontSize="12" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RootPage}"   FontSize="12" />
                                                    <TextBlock Grid.Column="3" Text="{Binding RecoveryMethod}" FontSize="11" Opacity="0.7" />
                                                    <StackPanel Grid.Column="4"
                                                                Orientation="Horizontal"
                                                                Spacing="4"
                                                                VerticalAlignment="Center">
                                                        <Border Width="8" Height="8"
                                                                CornerRadius="4"
                                                                Background="{Binding StatusBrush}"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusLabel}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="5"
                                                               Text="{Binding Sql}"
                                                               FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding Sql}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                </Grid>

                            </Grid>

                            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                            <!-- Right: hex view of the selected row's page -->
                            <Grid Grid.Column="2">

                                <TextBlock IsVisible="{Binding HasSchemaSelection,
                                                       Converter={x:Static conv:BoolConverters.Not}}"
                                           Text="← Select a row to view its bytes"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.35"
                                           FontSize="13" />

                                <TabControl IsVisible="{Binding HasSchemaSelection}"
                                            Padding="0">

                                    <!-- Tab: Hex View -->
                                    <TabItem Header="Hex View">
                                        <Grid RowDefinitions="Auto,*">

                                            <Border Grid.Row="0"
                                                    Padding="8,4"
                                                    BorderThickness="0,0,0,1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ToggleButton x:Name="SchemaOffsetToggle"
                                                                  Content="Dec Offsets"
                                                                  IsChecked="False"
                                                                  Padding="8,2"
                                                                  FontSize="11" />
                                                    <ToggleButton x:Name="SchemaHighlightToggle"
                                                                  Content="Highlights"
                                                                  IsChecked="True"
                                                                  Padding="8,2"
                                                                  FontSize="11" />
                                                    <TextBlock Text="{Binding #SchemaHexView.HoveredLabel}"
                                                               IsVisible="{Binding #SchemaHexView.HoveredLabel,
                                                                           Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Opacity="0.75"
                                                               Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <ScrollViewer Grid.Row="1"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Auto">
                                                <controls:HexView x:Name="SchemaHexView"
                                                                  Margin="14,8,14,16"
                                                                  Data="{Binding SchemaPageBytes}"
                                                                  Highlights="{Binding SchemaHighlights}"
                                                                  UseDecimalOffsets="{Binding #SchemaOffsetToggle.IsChecked}"
                                                                  ShowHighlights="{Binding #SchemaHighlightToggle.IsChecked}" />
                                            </ScrollViewer>

                                        </Grid>
                                    </TabItem>

                                    <!-- Tab: Recovered Records (valid deleted tables only) -->
                                    <TabItem Header="{Binding RecoveredDeletedRecordsHeader}"
                                             IsVisible="{Binding HasRecoveredDeletedRecords}">
                                        <Grid>
                                            <TextBlock IsVisible="{Binding HasRecoveredDeletedRecords,
                                                                   Converter={x:Static conv:BoolConverters.Not}}"
                                                       Text="No records recovered from this table"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.35"
                                                       FontSize="12" />
                                            <ScrollViewer IsVisible="{Binding HasRecoveredDeletedRecords}"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding RecoveredDeletedRecords}"
                                                              Margin="14,10">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RecoveredDeletedRecordViewModel">
                                                            <Expander Header="{Binding Header}"
                                                                      IsExpanded="True"
                                                                      Margin="0,2,0,0">
                                                                <ItemsControl ItemsSource="{Binding Fields}"
                                                                              Margin="8,4,0,4">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:InfoRow">
                                                                            <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                                <TextBlock Grid.Column="0"
                                                                                           Text="{Binding Label}"
                                                                                           FontSize="12"
                                                                                           FontWeight="SemiBold"
                                                                                           Opacity="0.6" />
                                                                                <TextBlock Grid.Column="1"
                                                                                           Text="{Binding Value}"
                                                                                           FontSize="12"
                                                                                           TextWrapping="Wrap" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </TabItem>

                                </TabControl>
                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- ── Tab 4: Search ── -->
                    <TabItem Header="Search">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">

                            <!-- Search bar -->
                            <Border Grid.Row="0"
                                    Padding="10,6"
                                    BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding SearchTab.Pattern}"
                                             Watermark="Regular expression  (e.g.  CREATE TABLE|\x00\xFF)"
                                             FontFamily="Courier New"
                                             FontSize="12"
                                             KeyDown="OnSearchBoxKeyDown" />
                                    <Button Grid.Column="1"
                                            Content="Search"
                                            Command="{Binding SearchTab.SearchCommand}"
                                            Padding="16,4"
                                            Margin="6,0,0,0" />
                                </Grid>
                            </Border>

                            <!-- Error / summary row -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding SearchTab.ErrorMessage}"
                                       IsVisible="{Binding SearchTab.ErrorMessage,
                                                   Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                       Foreground="#E05C5C"
                                       Padding="10,4"
                                       FontSize="11" />
                            <TextBlock Grid.Row="2"
                                       Text="{Binding SearchTab.Summary}"
                                       IsVisible="{Binding SearchTab.HasResults}"
                                       Opacity="0.55"
                                       Padding="10,2"
                                       FontSize="11" />

                            <!-- Placeholder: not searched yet -->
                            <TextBlock Grid.Row="3"
                                       IsVisible="{Binding SearchTab.ShowPlaceholder}"
                                       Text="Enter a pattern above and click Search"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.35"
                                       FontSize="13" />

                            <!-- Placeholder: no results -->
                            <TextBlock Grid.Row="3"
                                       IsVisible="{Binding SearchTab.ShowNoResults}"
                                       Text="No matches found"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.35"
                                       FontSize="13" />

                            <!-- Results: grouped list + hex view -->
                            <Grid Grid.Row="3"
                                  IsVisible="{Binding SearchTab.HasResults}"
                                  ColumnDefinitions="455,4,*">

                                <!-- Left: page groups -->
                                <ScrollViewer Grid.Column="0"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding SearchTab.Results}"
                                                  Margin="4,4">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SearchPageGroupViewModel">
                                                <Expander Header="{Binding Header}"
                                                          IsExpanded="False"
                                                          Expanded="OnSearchGroupExpanded"
                                                          Margin="0,2,0,0">
                                                    <ItemsControl ItemsSource="{Binding Hits}"
                                                                  Margin="8,2,0,2">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:SearchHitViewModel">
                                                                <Button Content="{Binding Preview}"
                                                                        Click="OnSearchHitClicked"
                                                                        HorizontalAlignment="Stretch"
                                                                        HorizontalContentAlignment="Left"
                                                                        Padding="6,3"
                                                                        Margin="0,1"
                                                                        FontFamily="Courier New"
                                                                        FontSize="11" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                                <!-- Right: toolbar + hex view -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,*">

                                    <Border Grid.Row="0"
                                            Padding="8,4"
                                            BorderThickness="0,0,0,1">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <ToggleButton x:Name="SearchOffsetToggle"
                                                          Content="Dec Offsets"
                                                          IsChecked="False"
                                                          Padding="8,2"
                                                          FontSize="11" />
                                            <ToggleButton x:Name="SearchHighlightToggle"
                                                          Content="Highlights"
                                                          IsChecked="True"
                                                          Padding="8,2"
                                                          FontSize="11" />
                                            <TextBlock Text="{Binding #SearchHexView.HoveredLabel}"
                                                       IsVisible="{Binding #SearchHexView.HoveredLabel,
                                                                   Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                        <ScrollViewer Grid.Column="0"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Auto">
                                            <controls:HexView x:Name="SearchHexView"
                                                              Margin="14,8,14,16"
                                                              Data="{Binding SearchTab.SelectedPageBytes}"
                                                              Highlights="{Binding SearchTab.SelectedHighlights}"
                                                              UseDecimalOffsets="{Binding #SearchOffsetToggle.IsChecked}"
                                                              ShowHighlights="{Binding #SearchHighlightToggle.IsChecked}" />
                                        </ScrollViewer>
                                        <controls:DataInspectorControl Grid.Column="1"
                                                                       Data="{Binding #SearchHexView.Data}"
                                                                       Offset="{Binding #SearchHexView.CursorOffset}" />
                                    </Grid>

                                </Grid>
                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- ── Tab 5: Query ── -->
                    <TabItem Header="Query">
                        <Grid RowDefinitions="Auto,Auto,Auto,*">

                            <Grid Grid.Row="0" Grid.RowSpan="4"
                                  ColumnDefinitions="220,4,*">

                                <!-- Left: table list -->
                                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                                    <Border Grid.Row="0"
                                            Padding="10,6"
                                            BorderThickness="0,0,0,1">
                                        <TextBlock Text="Tables"
                                                   FontWeight="SemiBold"
                                                   FontSize="11"
                                                   Opacity="0.6" />
                                    </Border>
                                    <ListBox Grid.Row="1"
                                             ItemsSource="{Binding QueryTab.TableNames}"
                                             DoubleTapped="OnTableDoubleTapped">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:QueryTableViewModel">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontFamily="Courier New"
                                                           FontSize="12"
                                                           ToolTip.Tip="Double-click to query this table" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>

                                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                                <!-- Right: query editor + results -->
                                <Grid Grid.Column="2" RowDefinitions="Auto,Auto,Auto,Auto,*">

                                    <!-- Query bar -->
                                    <Border Grid.Row="0"
                                            Padding="10,6"
                                            BorderThickness="0,0,0,1">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding QueryTab.QueryText}"
                                                     Watermark="SELECT * FROM table_name  (Enter to run, Shift+Enter for new line)"
                                                     FontFamily="Courier New"
                                                     FontSize="12"
                                                     AcceptsReturn="False"
                                                     MinHeight="32"
                                                     MaxHeight="120"
                                                     TextWrapping="Wrap"
                                                     KeyDown="OnQueryBoxKeyDown" />
                                            <Button Grid.Column="1"
                                                    Content="Run"
                                                    Command="{Binding QueryTab.RunQueryCommand}"
                                                    Padding="16,4"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>

                                    <!-- Include recovered records toggle -->
                                    <Border Grid.Row="1"
                                            Padding="10,4"
                                            BorderThickness="0,0,0,1">
                                        <CheckBox Content="Include recovered records"
                                                  IsChecked="{Binding QueryTab.IncludeDeletedRecords}"
                                                  FontSize="11" />
                                    </Border>

                                    <!-- Error / summary row -->
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding QueryTab.ErrorMessage}"
                                               IsVisible="{Binding QueryTab.HasError}"
                                               Foreground="#E05C5C"
                                               Padding="10,4"
                                               FontSize="11" />
                                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto"
                                          IsVisible="{Binding QueryTab.HasRun}">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding QueryTab.Summary}"
                                                   Opacity="0.55"
                                                   Padding="10,4"
                                                   VerticalAlignment="Center"
                                                   FontSize="11" />
                                        <Button Grid.Column="1"
                                                Content="Export CSV"
                                                IsVisible="{Binding QueryTab.HasResults}"
                                                Click="OnExportCsvClick"
                                                Padding="10,3"
                                                Margin="0,2,10,2"
                                                FontSize="11" />
                                    </Grid>

                                    <!-- Results grid -->
                                    <dg:DataGrid Grid.Row="4"
                                                 x:Name="ResultsGrid"
                                                 ItemsSource="{Binding QueryTab.Results}"
                                                 AutoGenerateColumns="False"
                                                 IsReadOnly="True"
                                                 GridLinesVisibility="All"
                                                 Margin="10"
                                                 FontSize="12" />

                                </Grid>

                            </Grid>

                        </Grid>
                    </TabItem>

                    <!-- ── Tab 6: WAL ── -->
                    <TabItem Header="{Binding WalTab.TabHeader}"
                             IsVisible="{Binding HasWal}">
                        <Grid RowDefinitions="Auto,*">

                            <!-- WAL header (collapsible) -->
                            <Expander Grid.Row="0"
                                      Header="WAL Header"
                                      IsExpanded="False"
                                      Padding="8,4">
                                <ScrollViewer MaxHeight="200"
                                              Padding="16,8"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding WalTab.HeaderRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InfoRow">
                                                <Grid ColumnDefinitions="180,*" Margin="0,4">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Label}"
                                                               FontWeight="SemiBold"
                                                               Opacity="0.6"
                                                               FontSize="12" />
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               FontFamily="Courier New"
                                                               FontSize="12" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Expander>

                            <!-- Main area: frame list | tabbed detail | hex -->
                            <Grid Grid.Row="1" ColumnDefinitions="240,4,*">

                                <!-- Frame list -->
                                <ListBox Grid.Column="0"
                                         ItemsSource="{Binding WalTab.Frames}"
                                         SelectedItem="{Binding WalTab.SelectedFrame}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WalFrameEntryViewModel">
                                            <Grid ColumnDefinitions="5,36,44,Auto,*,Auto" Height="26">
                                                <Border Grid.Column="0"
                                                        Background="{Binding TypeBrush}"
                                                        CornerRadius="2,0,0,2" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding FrameIndex}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"
                                                           Padding="0,0,6,0"
                                                           FontSize="11"
                                                           Opacity="0.4" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding PageNumber}"
                                                           VerticalAlignment="Center"
                                                           TextAlignment="Right"
                                                           Padding="0,0,8,0"
                                                           FontSize="11"
                                                           Opacity="0.55" />
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding TypeLabel}"
                                                           VerticalAlignment="Center"
                                                           FontSize="12" />
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding TableName}"
                                                           IsVisible="{Binding HasTable}"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Opacity="0.6"
                                                           Padding="8,0,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="5"
                                                           Text="COMMIT"
                                                           IsVisible="{Binding IsCommit}"
                                                           VerticalAlignment="Center"
                                                           FontSize="10"
                                                           Opacity="0.55"
                                                           Padding="6,0,8,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                                <!-- Frame detail area -->
                                <Grid Grid.Column="2">

                                    <TextBlock IsVisible="{Binding WalTab.SelectedFrameDetail,
                                                           Converter={x:Static conv:ObjectConverters.IsNull}}"
                                               Text="← Select a frame from the list"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0.35"
                                               FontSize="13" />

                                    <Grid IsVisible="{Binding WalTab.SelectedFrameDetail,
                                                      Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                          ColumnDefinitions="*,4,*">

                                        <!-- Left: tabbed detail -->
                                        <TabControl Grid.Column="0" Padding="0">

                                            <!-- Tab: Page Data -->
                                            <TabItem Header="Page Data">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <StackPanel Margin="14,10" Spacing="6">
                                                        <TextBlock Text="{Binding WalTab.SelectedFrameDetail.Summary}"
                                                                   FontFamily="Courier New"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap" />
                                                        <Expander Header="{Binding WalTab.SelectedFrameDetail.CellPointerHeader}"
                                                                  IsExpanded="False"
                                                                  IsVisible="{Binding WalTab.SelectedFrameDetail.HasCellPointers}">
                                                            <ItemsControl ItemsSource="{Binding WalTab.SelectedFrameDetail.CellPointerRows}"
                                                                          Margin="8,4,0,4">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:InfoRow">
                                                                        <Grid ColumnDefinitions="52,*" Margin="0,2">
                                                                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontFamily="Courier New" FontSize="11" Opacity="0.55" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Courier New" FontSize="11" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Expander>
                                                        <ItemsControl ItemsSource="{Binding WalTab.SelectedFrameDetail.CellSections}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:CellSectionViewModel">
                                                                    <Expander Header="{Binding Header}"
                                                                              IsExpanded="False"
                                                                              Expanded="OnWalCellSectionExpanded"
                                                                              Margin="0,2,0,0">
                                                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8,4,0,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:InfoRow">
                                                                                    <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding WalTab.SelectedFrameDetail.FreeBlockSections}"
                                                                      IsVisible="{Binding WalTab.SelectedFrameDetail.HasFreeBlocks}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:FreeBlockSectionViewModel">
                                                                    <Expander Header="{Binding Header}"
                                                                              IsExpanded="False"
                                                                              Expanded="OnWalFreeBlockSectionExpanded"
                                                                              Margin="0,2,0,0">
                                                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8,4,0,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:InfoRow">
                                                                                    <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding WalTab.SelectedFrameDetail.UnallocatedRegionSections}"
                                                                      IsVisible="{Binding WalTab.SelectedFrameDetail.HasUnallocatedRegions}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="vm:UnallocatedRegionSectionViewModel">
                                                                    <Expander Header="{Binding Header}"
                                                                              IsExpanded="False"
                                                                              Expanded="OnWalUnallocatedRegionSectionExpanded"
                                                                              Margin="0,2,0,0">
                                                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="8,4,0,4">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="vm:InfoRow">
                                                                                    <Grid ColumnDefinitions="120,*" Margin="0,2">
                                                                                        <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Expander>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </TabItem>

                                            <!-- Tab: Changes -->
                                            <TabItem Header="Changes">
                                                <Grid>
                                                    <TextBlock IsVisible="{Binding WalTab.HasComparison,
                                                                           Converter={x:Static conv:BoolConverters.Not}}"
                                                               Text="No comparison available for this page type"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.35"
                                                               FontSize="13" />
                                                    <ScrollViewer IsVisible="{Binding WalTab.HasComparison}"
                                                                  VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled">
                                                        <StackPanel Margin="14,10" Spacing="4">
                                                            <TextBlock Text="{Binding WalTab.SelectedFrameComparison.ComparedAgainst}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Opacity="0.6" />
                                                            <TextBlock Text="No changes detected"
                                                                       IsVisible="{Binding WalTab.SelectedFrameComparison.HasAnyChanges,
                                                                                   Converter={x:Static conv:BoolConverters.Not}}"
                                                                       FontSize="12"
                                                                       Opacity="0.45"
                                                                       Margin="4,4,0,0" />
                                                            <Expander Header="{Binding WalTab.SelectedFrameComparison.AddedHeader}"
                                                                      IsExpanded="True"
                                                                      IsVisible="{Binding WalTab.SelectedFrameComparison.HasAdded}">
                                                                <ItemsControl ItemsSource="{Binding WalTab.SelectedFrameComparison.AddedRows}"
                                                                              Margin="8,4,0,4">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:InfoRow">
                                                                            <TextBlock Text="{Binding Value}"
                                                                                       FontSize="12"
                                                                                       FontFamily="Courier New"
                                                                                       Margin="0,2" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                            <Expander Header="{Binding WalTab.SelectedFrameComparison.RemovedHeader}"
                                                                      IsExpanded="True"
                                                                      IsVisible="{Binding WalTab.SelectedFrameComparison.HasRemoved}">
                                                                <ItemsControl ItemsSource="{Binding WalTab.SelectedFrameComparison.RemovedRows}"
                                                                              Margin="8,4,0,4">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:InfoRow">
                                                                            <TextBlock Text="{Binding Value}"
                                                                                       FontSize="12"
                                                                                       FontFamily="Courier New"
                                                                                       Margin="0,2" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                            <Expander Header="{Binding WalTab.SelectedFrameComparison.UpdatedHeader}"
                                                                      IsExpanded="True"
                                                                      IsVisible="{Binding WalTab.SelectedFrameComparison.HasUpdated}">
                                                                <ItemsControl ItemsSource="{Binding WalTab.SelectedFrameComparison.UpdatedSections}"
                                                                              Margin="4,4,0,4">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:UpdatedRecordSectionViewModel">
                                                                            <Expander Header="{Binding Header}"
                                                                                      IsExpanded="False"
                                                                                      Margin="0,2,0,0">
                                                                                <ItemsControl ItemsSource="{Binding Rows}" Margin="8,4,0,4">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="vm:InfoRow">
                                                                                            <Grid ColumnDefinitions="80,*" Margin="0,2">
                                                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Opacity="0.6" />
                                                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Expander>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </Expander>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                </Grid>
                                            </TabItem>

                                        </TabControl>

                                        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                                        <!-- Hex view -->
                                        <Grid Grid.Column="2" RowDefinitions="Auto,*">
                                            <Border Grid.Row="0"
                                                    Padding="8,4"
                                                    BorderThickness="0,0,0,1">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <ToggleButton x:Name="WalOffsetToggle"
                                                                  Content="Dec Offsets"
                                                                  IsChecked="False"
                                                                  Padding="8,2"
                                                                  FontSize="11" />
                                                    <ToggleButton x:Name="WalHighlightToggle"
                                                                  Content="Highlights"
                                                                  IsChecked="True"
                                                                  Padding="8,2"
                                                                  FontSize="11" />
                                                    <TextBlock Text="{Binding #WalHexView.HoveredLabel}"
                                                               IsVisible="{Binding #WalHexView.HoveredLabel,
                                                                           Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                               VerticalAlignment="Center"
                                                               FontSize="11"
                                                               Opacity="0.75"
                                                               Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                                <ScrollViewer Grid.Column="0"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto">
                                                    <controls:HexView x:Name="WalHexView"
                                                                      Margin="14,8,14,16"
                                                                      Data="{Binding WalTab.SelectedFrameDetail.PageBytes}"
                                                                      Highlights="{Binding WalTab.SelectedFrameDetail.PageHighlights}"
                                                                      UseDecimalOffsets="{Binding #WalOffsetToggle.IsChecked}"
                                                                      ShowHighlights="{Binding #WalHighlightToggle.IsChecked}" />
                                                </ScrollViewer>
                                                <controls:DataInspectorControl Grid.Column="1"
                                                                               Data="{Binding #WalHexView.Data}"
                                                                               Offset="{Binding #WalHexView.CursorOffset}" />
                                            </Grid>
                                        </Grid>

                                    </Grid>
                                </Grid>

                            </Grid>
                        </Grid>
                    </TabItem>

                </TabControl>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
