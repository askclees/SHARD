<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SHARD.Views.BlobViewerWindow"
        Title="Blob Viewer"
        Width="640" Height="520"
        MinWidth="320" MinHeight="240"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="12">

        <Border Grid.Row="0"
                Name="ContentHost"
                BorderThickness="1"
                Padding="8" />

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              Margin="0,10,0,0">
            <TextBlock Grid.Column="0"
                       Name="StatusText"
                       VerticalAlignment="Center"
                       Opacity="0.6"
                       FontSize="11" />
            <Button Grid.Column="1"
                    Name="SaveAsButton"
                    Content="Save As…"
                    Padding="14,4"
                    Margin="0,0,8,0"
                    ToolTip.Tip="Saves the original, untranscoded bytes — not whatever preview is shown above." />
            <Button Grid.Column="2"
                    Name="CloseButton"
                    Content="Close"
                    Padding="14,4" />
        </Grid>

    </Grid>
</Window>
