<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SHARD.Views.SettingsWindow"
        Title="Settings"
        Width="460" Height="210"
        MinWidth="400" MinHeight="210"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="*,Auto" Margin="16">

        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Large database threshold"
                       FontWeight="SemiBold"
                       FontSize="13" />
            <TextBlock Text="Opening a SQLite file at or above this size prompts to build the shadow database directly in a project folder on disk, instead of temporary storage."
                       Opacity="0.6"
                       FontSize="12"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <NumericUpDown Name="ThresholdBox"
                               Minimum="1"
                               Maximum="1048576"
                               Increment="1"
                               FormatString="0"
                               Width="160" />
                <TextBlock Text="MB" VerticalAlignment="Center" FontSize="13" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,12,0,0">
            <Button Name="CancelButton" Content="Cancel" Padding="14,4" />
            <Button Name="SaveButton" Content="Save" Padding="14,4" />
        </StackPanel>

    </Grid>
</Window>
