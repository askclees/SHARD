<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SHARD.ViewModels"
             x:Class="SHARD.Controls.DataInspectorControl">

    <Border BorderThickness="1,0,0,0">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Pop-out toolbar -->
            <Border Grid.Row="0" BorderThickness="0,0,0,1" Padding="4,2">
                <Button x:Name="PopOutButton"
                        HorizontalAlignment="Right"
                        Padding="3,1"
                        Background="Transparent"
                        BorderThickness="0"
                        FontSize="11"
                        Opacity="0.55"
                        ToolTip.Tip="Open in floating window"
                        Click="OnPopOutClicked">⧉</Button>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="RowsControl" Margin="8,6,8,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:InfoRow">
                            <Grid ColumnDefinitions="76,*" Margin="0,2">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Label}"
                                           FontSize="11"
                                           Opacity="0.55" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Value}"
                                           FontFamily="Courier New"
                                           FontSize="11"
                                           TextWrapping="NoWrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Selection info: shown when a byte range is selected -->
            <Border Grid.Row="2"
                    x:Name="SelectionPanel"
                    IsVisible="False"
                    BorderThickness="0,1,0,0"
                    Padding="8,6,8,8">
                <StackPanel Spacing="0">
                    <TextBlock Text="Selection"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Opacity="0.45"
                               Margin="0,0,0,4" />
                    <ItemsControl x:Name="SelectionRowsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:InfoRow">
                                <Grid ColumnDefinitions="76,*" Margin="0,2">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Label}"
                                               FontSize="11"
                                               Opacity="0.55" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Value}"
                                               FontFamily="Courier New"
                                               FontSize="11"
                                               TextWrapping="NoWrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
