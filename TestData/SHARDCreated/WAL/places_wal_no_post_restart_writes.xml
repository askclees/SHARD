<?xml version="1.0" encoding="utf-8"?>
<!--
  SHARD WAL test expectations for places_wal_no_post_restart_writes.db: rows deleted within the
  WAL that survive only in an earlier committed frame.

  Rows 1-10 are inserted in one transaction (frame 3) and rows 4-6 deleted in the next (frame 4);
  PRAGMA wal_checkpoint(RESTART) then copies both into the database file, and the process is killed
  with no further write, so every frame keeps the current salt and is committed. Frame 3 is
  committed but superseded by frame 4 for the same page.

  The file was built with secure_delete on, so deleting rows 4-6 zeroed their bytes in frame 4 and
  in the database file: frame 3's live cells are the only surviving copy. SHARD must recover them
  from there, and must not report any of the 7 rows that are still live (they appear in every
  frame) as deleted.

  Live rows (main DB raw, bypassing WAL):  7  (ids 1-3, 7-10)
  WAL-recovered deleted rows:              3  (ids 4-6, wal_frame, frame 3)
-->
<database>
    <element>
        <meta>
            <type>table</type>
            <name>moz_places</name>
            <deleted>False</deleted>
            <rowsAlive>7</rowsAlive>
            <rowsDeleted>3</rowsDeleted>
        </meta>
        <rows>
            <row deleted="1">
                <column><name>id</name><content>4</content></column>
                <column><name>url</name><content>https://example4.com/</content></column>
                <column><name>title</name><content>Title 4</content></column>
                <column><name>visit_count</name><content>4</content></column>
                <column><name>last_visit_date</name><content>1700000004</content></column>
                <column><name>frecency</name><content>40</content></column>
            </row>
            <row deleted="1">
                <column><name>id</name><content>5</content></column>
                <column><name>url</name><content>https://example5.com/</content></column>
                <column><name>title</name><content>Title 5</content></column>
                <column><name>visit_count</name><content>5</content></column>
                <column><name>last_visit_date</name><content>1700000005</content></column>
                <column><name>frecency</name><content>50</content></column>
            </row>
            <row deleted="1">
                <column><name>id</name><content>6</content></column>
                <column><name>url</name><content>https://example6.com/</content></column>
                <column><name>title</name><content>Title 6</content></column>
                <column><name>visit_count</name><content>6</content></column>
                <column><name>last_visit_date</name><content>1700000006</content></column>
                <column><name>frecency</name><content>60</content></column>
            </row>
        </rows>
    </element>
</database>
