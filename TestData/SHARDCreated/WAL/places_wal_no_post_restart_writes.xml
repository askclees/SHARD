        <meta>
            <type>table</type>
            <name>moz_places</name>
            <deleted>False</deleted>
            <rowsAlive>7</rowsAlive>
            <rowsDeleted>0</rowsDeleted>
        </meta>
        <rows>
        </rows>
    </element>
</database>
