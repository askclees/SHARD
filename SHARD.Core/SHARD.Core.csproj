<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <PackageId>SHARD.Core</PackageId>
        <Version>0.9.0</Version>
        <Authors>askclees</Authors>
        <Description>Forensic SQLite recovery engine: parses raw SQLite database files — including corrupted or partially-overwritten ones — and recovers deleted/freeblock records, WAL-history records, and orphan-page-carved records via schema content matching. SqliteRecoveryFacade is the high-level entry point.</Description>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <RepositoryUrl>https://github.com/askclees/SHARD</RepositoryUrl>
        <PackageProjectUrl>https://github.com/askclees/SHARD</PackageProjectUrl>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\LICENSE" Pack="true" PackagePath="" />
    </ItemGroup>

</Project>
